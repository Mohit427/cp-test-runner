{
  "name": "cp-test-runner",
  "displayName": "CP Test Runner",
  "description": "Run C++ solutions against sample tests with a live results panel",
  "version": "0.1.0",
  "publisher": "mohit427",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mohit427/cp-test-runner.git"
  },
  "bugs": {
    "url": "https://github.com/Mohit427/cp-test-runner/issues"
  },
  "homepage": "https://github.com/Mohit427/cp-test-runner#readme",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "competitive programming",
    "c++",
    "test runner",
    "codeforces",
    "leetcode",
    "icpc"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cp-test-runner.runAgainstSamples",
        "title": "Run Against Samples",
        "category": "CP Test Runner"
      }
    ],
    "keybindings": [
      {
        "command": "cp-test-runner.runAgainstSamples",
        "key": "ctrl+alt+r",
        "when": "editorLangId == cpp"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}